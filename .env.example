# Variables d'environnement — exemple pour une app Next.js + Supabase
# Copie ce fichier en .env.local dans le dossier de ton app et remplis les valeurs.

# Supabase — récupère ces valeurs dans Settings → API de ton projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optionnel : webhook n8n pour intégrer un workflow externe
N8N_WEBHOOK_URL=https://ton-instance-n8n.example.com/webhook/ton-endpoint
